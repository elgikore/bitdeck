<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BitDeck.Experiments.AudioVisualizerTest.AudioVisualizerTest"
        Title="AudioVisualizerTest">
    <Grid RowDefinitions="*, 50">
        <Grid RowDefinitions="*, *, *" ColumnDefinitions="0.25*, *" Background="White">
            <TextBlock TextAlignment="Center" 
                       VerticalAlignment="Center" 
                       Foreground="Black" 
                       FontSize="16">
                DB Meters
                <LineBreak/>
                <LineBreak/>
                (Peak/Max Amplitude
                <LineBreak/>
                and RMS/Perceived Loudness)
            </TextBlock>
            
            <avalonia:AvaPlot Grid.Row="0" Grid.Column="1" x:Name="Plot" UseLayoutRounding="True"  />
            
            
            <TextBlock Grid.Row="1" Grid.Column="0" 
                       TextAlignment="Center" 
                       VerticalAlignment="Center" 
                       Foreground="Black" 
                       FontSize="16">
                Actual Waveform
                <LineBreak/>
                <LineBreak/>
                (Oscilloscope View)
            </TextBlock>
            
            <avalonia:AvaPlot Grid.Row="1" Grid.Column="1" x:Name="RealPlot" UseLayoutRounding="True" />
            
            <TextBlock Grid.Row="2" Grid.Column="0" 
                       TextAlignment="Center" 
                       VerticalAlignment="Center" 
                       Foreground="Black" 
                       FontSize="16">
                Spectrum/FFT 
                <LineBreak/>
                <LineBreak/>
                (10-band Display)
            </TextBlock>
            
            <avalonia:AvaPlot Grid.Row="2" Grid.Column="1" x:Name="FftPlot" />
        </Grid>
        
        <Button Grid.Row="1" Content="Play Visualizer" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Click="PlayButton_Click" />
    </Grid>
</Window>
